{
  "name": "badge42",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate --schema=./db/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./db/schema.prisma --skip-seed",
    "db:reset": "prisma migrate reset --schema=./db/schema.prisma --skip-seed",
    "db:push": "prisma db push --schema=./db/schema.prisma",
    "db:seed": "npx prisma db seed",
    "db:studio": "prisma studio --schema=./db/schema.prisma",
    "now-build": "yarn db:generate && next build",
    "assets:download": "ts-node --compiler-options {\"module\":\"CommonJS\"} scripts/downloadAssets.ts",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} db/seed.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@icons-pack/react-simple-icons": "^9.4.0",
    "@prisma/client": "^5.7.1",
    "axios": "^1.6.0",
    "lodash-es": "^4.17.21",
    "next": "14.0.4",
    "next-auth": "^4.24.5",
    "node-cache": "^5.1.2",
    "p-queue": "^8.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "string-pixel-width": "^1.10.0"
  },
  "devDependencies": {
    "@rvxlab/tailwind-plugin-ios-full-height": "^1.1.0",
    "@types/lodash-es": "^4.17.9",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@types/sharp": "^0.32.0",
    "@types/string-pixel-width": "^1.7.2",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-config-next": "14.0.4",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.0",
    "prisma": "^5.7.1",
    "sharp": "^0.32.6",
    "tailwindcss": "^3.3.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
